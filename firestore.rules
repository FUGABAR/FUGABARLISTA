rules_version = '2';

// Regra simples: qualquer pessoa que abriu o app (mesmo anonimamente,
// via signInAnonymously) pode ler e escrever. Quem pode fazer o quê
// dentro do app é controlado pela tela (PIN de ADM x PIN de Operador),
// não por este arquivo. Veja o README.md, seção "Sobre a segurança",
// para entender esse limite e como evoluir se um dia precisar de mais.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
